    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Left rail nav; active item is a solid red block.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item is-active\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"/><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/></svg>Overview</a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg>Drivers</a></nav>",
      "css": ":host{--surface-0:#0e1013;--surface-1:#08090b;--surface-2:#16191e;--surface-3:#1f232a;--line:#262a31;--line-strong:#353a43;--ink:#f2f4f7;--ink-2:#a9b0bb;--ink-3:#8a919c;--accent:#e10600;--accent-ink:#ff4136;--on-accent:#fff;--best:#b98bff;--gain:#3ddc84;--caution:#ffc21a;--danger:#ff4136;--shadow:0 1px 2px rgb(0 0 0 / 0.4),0 8px 24px -8px rgb(0 0 0 / 0.5);} .ds-nav{font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;display:flex;flex-direction:column;gap:4px;width:192px;padding:16px;background:var(--surface-1);} .ds-nav-item{display:flex;align-items:center;gap:12px;height:40px;padding:0 12px;border-radius:6px;font-size:0.875rem;font-weight:500;color:var(--ink-2);text-decoration:none;transition:background-color 150ms,color 150ms;} .ds-nav-item:hover{background:var(--surface-3);color:var(--ink);} .ds-nav-item.is-active{background:var(--accent);color:var(--on-accent);} .ds-nav-item:focus-visible{outline:2px solid var(--accent-ink,#ff4136);outline-offset:2px;}"
    },
    {
      "name": "Timing-Tower Row",
      "kind": "custom",
      "refersTo": "standings-row",
      "description": "Signature standings row: position, team stripe, name, points, gap; P1 shows LEADER in sector purple.",
      "html": "<ol class=\"ds-tower\"><li><a class=\"ds-row\" href=\"#\"><span class=\"ds-pos\">1</span><span class=\"ds-stripe\" style=\"background:#FF8000\"></span><span class=\"ds-name\"><b>McLaren</b><small>Norris · Piastri</small></span><span class=\"ds-pts\"><b>756</b><small>pts</small></span><span class=\"ds-gap ds-leader\">Leader</span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></a></li><li><a class=\"ds-row\" href=\"#\"><span class=\"ds-pos\">2</span><span class=\"ds-stripe\" style=\"background:#00A19B\"></span><span class=\"ds-name\"><b>Mercedes</b><small>Russell · Antonelli</small></span><span class=\"ds-pts\"><b>398</b><small>pts</small></span><span class=\"ds-gap\">−358</span><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></a></li></ol>",
      "css": ":host{--surface-0:#0e1013;--surface-1:#08090b;--surface-2:#16191e;--surface-3:#1f232a;--line:#262a31;--line-strong:#353a43;--ink:#f2f4f7;--ink-2:#a9b0bb;--ink-3:#8a919c;--accent:#e10600;--accent-ink:#ff4136;--on-accent:#fff;--best:#b98bff;--gain:#3ddc84;--caution:#ffc21a;--danger:#ff4136;--shadow:0 1px 2px rgb(0 0 0 / 0.4),0 8px 24px -8px rgb(0 0 0 / 0.5);} .ds-tower{font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;list-style:none;margin:0;padding:0;background:var(--surface-2);border:1px solid var(--line);border-radius:6px;} .ds-tower li+li{border-top:1px solid var(--line);} .ds-row{display:flex;align-items:center;gap:12px;min-height:56px;padding:8px 16px;color:var(--ink);text-decoration:none;transition:background-color 150ms;} .ds-row:hover{background:var(--surface-3);} .ds-row:focus-visible{outline:2px solid var(--accent-ink,#ff4136);outline-offset:2px;} .ds-pos{font-stretch:68%;font-weight:700;letter-spacing:-0.01em;line-height:1;width:32px;text-align:right;font-size:1.5rem;} .ds-stripe{width:4px;height:32px;border-radius:9999px;box-shadow:inset 0 0 0 1px var(--line);} .ds-name{flex:1;min-width:0;} .ds-name b{display:block;font-weight:600;} .ds-name small,.ds-pts small{display:block;font-size:0.75rem;color:var(--ink-2);} .ds-pts small{color:var(--ink-3);} .ds-pts{width:64px;text-align:right;} .ds-pts b{font-weight:600;} .ds-gap{width:64px;text-align:right;font-size:0.875rem;color:var(--ink-2);} .ds-leader{font-weight:600;text-transform:uppercase;color:var(--best);} .ds-row svg{color:var(--ink-3);flex-shrink:0;}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Raised panel with optional condensed uppercase title row.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-head\"><h2>Next race</h2></header><div class=\"ds-card-body\">Panel content.</div></section>",
      "css": ":host{--surface-0:#0e1013;--surface-1:#08090b;--surface-2:#16191e;--surface-3:#1f232a;--line:#262a31;--line-strong:#353a43;--ink:#f2f4f7;--ink-2:#a9b0bb;--ink-3:#8a919c;--accent:#e10600;--accent-ink:#ff4136;--on-accent:#fff;--best:#b98bff;--gain:#3ddc84;--caution:#ffc21a;--danger:#ff4136;--shadow:0 1px 2px rgb(0 0 0 / 0.4),0 8px 24px -8px rgb(0 0 0 / 0.5);} .ds-card{font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;background:var(--surface-2);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow);color:var(--ink-2);} .ds-card-head{padding:12px 20px;border-bottom:1px solid var(--line);} .ds-card-head h2{font-stretch:68%;font-weight:700;letter-spacing:-0.01em;line-height:1;margin:0;font-size:1.125rem;text-transform:uppercase;color:var(--ink);} .ds-card-body{padding:20px;font-size:0.875rem;}"
    },
    {
      "name": "Stat Tile",
      "kind": "card",
      "refersTo": "stat-tile",
      "description": "Key figure with uppercase label; numeral counts up on load.",
      "html": "<dl class=\"ds-stats\"><div class=\"ds-stat\"><dt>Seasons</dt><dd class=\"ds-stat-v\">77</dd><dd class=\"ds-stat-h\">1950–2026</dd></div><div class=\"ds-stat\"><dt>Wins</dt><dd class=\"ds-stat-v ds-best\">251</dd></div></dl>",
      "css": ":host{--surface-0:#0e1013;--surface-1:#08090b;--surface-2:#16191e;--surface-3:#1f232a;--line:#262a31;--line-strong:#353a43;--ink:#f2f4f7;--ink-2:#a9b0bb;--ink-3:#8a919c;--accent:#e10600;--accent-ink:#ff4136;--on-accent:#fff;--best:#b98bff;--gain:#3ddc84;--caution:#ffc21a;--danger:#ff4136;--shadow:0 1px 2px rgb(0 0 0 / 0.4),0 8px 24px -8px rgb(0 0 0 / 0.5);} .ds-stats{font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;display:grid;grid-template-columns:repeat(2,minmax(140px,1fr));gap:12px;margin:0;} .ds-stat{display:flex;flex-direction:column;gap:8px;padding:16px;background:var(--surface-2);border:1px solid var(--line);border-radius:6px;box-shadow:var(--shadow);} .ds-stat dt{font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-3,#8a919c);} .ds-stat dd{margin:0;} .ds-stat-v{font-stretch:68%;font-weight:700;letter-spacing:-0.01em;line-height:1;font-size:2.25rem;color:var(--ink);} .ds-best{color:var(--best);} .ds-stat-h{font-size:0.75rem;color:var(--ink-2);}"
    },
    {
      "name": "Countdown",
      "kind": "custom",
      "refersTo": "countdown-cell",
      "description": "Live countdown in inset cells with condensed digits.",
      "html": "<div class=\"ds-cd\"><div><b>03</b><span>days</span></div><div><b>01</b><span>hrs</span></div><div><b>23</b><span>min</span></div><div><b>16</b><span>sec</span></div></div>",
      "css": ":host{--surface-0:#0e1013;--surface-1:#08090b;--surface-2:#16191e;--surface-3:#1f232a;--line:#262a31;--line-strong:#353a43;--ink:#f2f4f7;--ink-2:#a9b0bb;--ink-3:#8a919c;--accent:#e10600;--accent-ink:#ff4136;--on-accent:#fff;--best:#b98bff;--gain:#3ddc84;--caution:#ffc21a;--danger:#ff4136;--shadow:0 1px 2px rgb(0 0 0 / 0.4),0 8px 24px -8px rgb(0 0 0 / 0.5);} .ds-cd{font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;display:flex;gap:8px;} .ds-cd div{min-width:56px;padding:8px;border-radius:6px;background:var(--surface-3);text-align:center;} .ds-cd b{font-stretch:68%;font-weight:700;letter-spacing:-0.01em;line-height:1;display:block;font-size:1.875rem;color:var(--ink);} .ds-cd span{font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-3,#8a919c);display:block;margin-top:4px;}"
    },
