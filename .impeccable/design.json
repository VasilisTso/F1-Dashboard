      "html": "<button class=\"ds-btn-outline\" type=\"button\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/></svg>Try again</button>",
      "css": ":host{--surface-0:#0e1013;--surface-1:#08090b;--surface-2:#16191e;--surface-3:#1f232a;--line:#262a31;--line-strong:#353a43;--ink:#f2f4f7;--ink-2:#a9b0bb;--ink-3:#8a919c;--accent:#e10600;--accent-ink:#ff4136;--on-accent:#fff;--best:#b98bff;--gain:#3ddc84;--caution:#ffc21a;--danger:#ff4136;--shadow:0 1px 2px rgb(0 0 0 / 0.4),0 8px 24px -8px rgb(0 0 0 / 0.5);} .ds-btn-outline{font-family:'Archivo',ui-sans-serif,system-ui,sans-serif;font-variant-numeric:tabular-nums;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:1px solid var(--line-strong);border-radius:6px;background:transparent;color:var(--ink);font-size:0.875rem;font-weight:500;cursor:pointer;transition:background-color 150ms;} .ds-btn-outline:hover{background:var(--surface-3);} .ds-btn-outline:focus-visible{outline:2px solid var(--accent-ink,#ff4136);outline-offset:2px;}"
